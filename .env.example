# Production deployment requires actual external services. Do not commit secrets.
# Inject these in CloudRun; the application does not automatically load this file.
APP_ENV=production
ALLOWED_APPIDS=YOUR_WECHAT_APPID
TCB_ENV=YOUR_CLOUDBASE_ENV_ID
PORT=8080
UVICORN_WORKERS=2
MAX_INFLIGHT=1
MAX_ASYNC_PENDING=8
COMPUTE_TIMEOUT_SECONDS=300
QUERY_RATE_LIMIT_PER_MIN=120
VALIDATION_RATE_LIMIT_PER_MIN=60
RATE_LIMIT_PER_MIN=20

# These attest platform configuration; setting them does NOT configure CloudRun.
# Disable PUBLIC/OA access first. Confirm workers have CPU after HTTP responses.
CLOUDRUN_ACCESS_MODE=miniapp-only
WORKER_EXECUTION_MODE=continuous

JOB_QUEUE_BACKEND=mysql
JOB_DB_HOST=
JOB_DB_PORT=3306
JOB_DB_NAME=
JOB_DB_USER=
JOB_DB_PASSWORD=
# Optional trusted CA for TLS (strongly preferred when not using a private VPC).
JOB_DB_SSL_CA=

COS_REGION=
COS_BUCKET=
TENCENTCLOUD_SECRETID=
TENCENTCLOUD_SECRETKEY=
TENCENTCLOUD_SESSIONTOKEN=
COS_URL_TTL_SECONDS=7200

# Local-only alternative: APP_ENV=development, JOB_QUEUE_BACKEND=sqlite;
# remove COS_REGION/COS_BUCKET, set PUBLIC_BASE_URL=http://127.0.0.1:8765.
# Never use SQLite WAL on a shared network filesystem or across CloudRun replicas.
